// routes/sheets.js
async function routes(fastify, options) {
  // CREATE SHEET (Connect Google/Excel URL)
  fastify.post('/connect', {
    schema: {
      body: {
        type: 'object',
        required: ['url'],
        properties: { url: { type: 'string' } }
      }
    }
  }, async (request, reply) => {
    const { url } = request.body;
    const sheetId = parseSheetId(url);
    
    // Analyze columns (1st row)
    const columns = await analyzeSheetColumns(url, sheetId);
    const rowCount = await getSheetRowCount(url, sheetId);
    
    // Setup webhook
    await setupWebhook(url, sheetId, request.headers.origin);
    
    // Cache metadata 60s
    await redisClient.setex(`sheet:${sheetId}`, 60, JSON.stringify({
      id: sheetId, name: extractName(url), columns, rowCount, status: 'live'
    }));
    
    return {
      id: sheetId,
      name: extractName(url),
      status: 'live',
      columns,
      rowCount,
      url,
      connectedAt: new Date().toISOString()
    };
  });

  // GET SINGLE SHEET DETAIL
  fastify.get('/:sheetId', {
    schema: {
      params: { sheetId: { type: 'string' } },
      querystring: { columns: { type: 'string' } }
    }
  }, async (request, reply) => {
    const { sheetId } = request.params;
    const { columns } = request.query;
    
    const cached = await redisClient.get(`sheet:${sheetId}`);
    if (cached) return JSON.parse(cached);
    
    const sheet = await fetchSheetMetadata(sheetId);
    await redisClient.setex(`sheet:${sheetId}`, 60, JSON.stringify(sheet));
    return sheet;
  });

  // LIST USER SHEETS
  fastify.get('/', async () => {
    const keys = await redisClient.keys('sheet:*');
    const sheets = await Promise.all(
      keys.map(async key => JSON.parse(await redisClient.get(key)))
    );
    return sheets;
  });
}
