## **3. COMPOSER ROUTES - Merge + Customize**

```javascript
// routes/composer.js
async function routes(fastify, options) {
  // CUSTOMIZE (Column filtering → Preview dashboard)
  fastify.post('/:sheetId/customize', {
    schema: {
      params: { sheetId: { type: 'string' } },
      body: {
        type: 'object',
        required: ['columns'],
        properties: { 
          columns: { type: 'array', items: { type: 'string' } } 
        }
      }
    }
  }, async (request, reply) => {
    const { sheetId } = request.params;
    const { columns } = request.body;
    
    // Fetch ONLY selected columns
    const metrics = await calculateMetrics(sheetId, columns);
    
    return {
      sheetId,
      selectedColumns: columns,
      previewMetrics: metrics,
      cardCount: Object.keys(metrics).length
    };
  });

  // MERGE (Add other sheets to primary)
  fastify.post('/:sheetId/merge', {
    schema: {
      params: { sheetId: { type: 'string' } },
      body: {
        type: 'object',
        required: ['otherSheets'],
        properties: { 
          otherSheets: { type: 'array', items: { type: 'string' } },
          columns: { type: 'array', items: { type: 'string' } }
        }
      }
    }
  }, async (request, reply) => {
    const { sheetId } = request.params;
    const { otherSheets, columns } = request.body;
    
    // Aggregate ALL sheets
    const allSheets = [sheetId, ...otherSheets];
    const mergedMetrics = await aggregateSheets(allSheets, columns);
    
    return {
      primarySheet: sheetId,
      mergedSheets: allSheets,
      previewMetrics: mergedMetrics,
      sheetCount: allSheets.length
    };
  });

  // SAVE DASHBOARD (User configuration)
  fastify.post('/save', {
    schema: {
      body: {
        type: 'object',
        required: ['name', 'sheets', 'columns', 'metrics'],
        properties: {
          name: { type: 'string' },
          sheets: { type: 'array', items: { type: 'string' } },
          columns: { type: 'array', items: { type: 'string' } },
          metrics: { type: 'object' }
        }
      }
    }
  }, async (request, reply) => {
    const { name, sheets, columns, metrics } = request.body;
    const dashboardId = `dash_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`;
    
    // Store user dashboard config (minimal - no data)
    await redisClient.setex(`dashboard:${dashboardId}`, 86400, JSON.stringify({
      id: dashboardId, name, sheets, columns, metrics, createdAt: new Date().toISOString()
    }));
    
    return { dashboardId, name, url: `/dashboard/${dashboardId}` };
  });
}
