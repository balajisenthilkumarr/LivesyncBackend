// services/googleSheets.js
export async function analyzeSheetColumns(url, sheetId) {
  const range = 'Sheet1!1:1'; // Header row
  const response = await fetch(
    `https://sheets.googleapis.com/v4/spreadsheets/${sheetId}?ranges=${range}&key=${process.env.GOOGLE_API_KEY}`
  );
  const data = await response.json();
  return data.valueRanges[0]?.values[0] || [];
}

export async function calculateMetrics(sheetId, columns) {
  const metrics = {};
  
  for (const column of columns) {
    const colIndex = getColumnIndex(column); // A=1, B=2
    const range = `Sheet1!${column}1:${column}1000`;
    
    const response = await fetch(
      `https://sheets.googleapis.com/v4/spreadsheets/${sheetId}?ranges=${range}`
    );
    const data = await response.json();
    
    const values = data.valueRanges[0]?.values || [];
    const numbers = values.map(row => parseFloat(row[0])).filter(Boolean);
    
    metrics[column] = {
      count: numbers.length,
      sum: numbers.reduce((a, b) => a + b, 0),
      avg: numbers.length ? numbers.reduce((a, b) => a + b, 0) / numbers.length : 0,
      max: numbers.length ? Math.max(...numbers) : 0
    };
  }
  
  return metrics;
}
```

