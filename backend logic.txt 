## **4. WEBHOOKS + Real-time**

```javascript
// routes/webhooks.js
async function routes(fastify, options) {
  // Google Sheets webhook
  fastify.post('/:sheetId', async (request, reply) => {
    const { sheetId } = request.params;
    const { column, newValue, user, cell } = request.body;
    
    // Broadcast to connected clients
    fastify.io.to(`sheet:${sheetId}`).emit('cellUpdate', {
      sheetId, column, newValue, user, cell, timestamp: new Date()
    });
    
    // Invalidate cache
    await redisClient.del(`sheet:${sheetId}`);
    await redisClient.del(`composer:${sheetId}`);
    
    // Notify merged dashboards
    const dashboards = await redisClient.keys(`dashboard:*`);
    for (const dashKey of dashboards) {
      const dash = JSON.parse(await redisClient.get(dashKey));
      if (dash.sheets.includes(sheetId)) {
        fastify.io.to(`dashboard:${dash.id}`).emit('metricUpdate', {
          dashboardId: dash.id,
          changedSheet: sheetId,
          column
        });
      }
    }
    
    reply.status(200).send({ status: 'received' });
  });
}
```

