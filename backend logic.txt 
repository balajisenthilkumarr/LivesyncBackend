## **6. Aggregator Service**

```javascript
// services/aggregator.js
export async function aggregateSheets(sheetIds, columns) {
  const results = {};
  
  for (const column of columns) {
    const allData = [];
    
    // Parallel fetch from all sheets
    const sheetData = await Promise.all(
      sheetIds.map(async sheetId => {
        const metrics = await calculateMetrics(sheetId, [column]);
        return metrics[column];
      })
    );
    
    // Aggregate across sheets
    const allNumbers = sheetData.flatMap(data => 
      Array(data.count).fill(data.avg)
    );
    
    results[column] = {
      count: allNumbers.length,
      sum: allNumbers.reduce((a, b) => a + b, 0),
      avg: allNumbers.length ? allNumbers.reduce((a, b) => a + b, 0) / allNumbers.length : 0,
      sheets: sheetIds.length
    };
  }
  
  return results;
}
```

